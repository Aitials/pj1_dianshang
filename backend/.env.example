# 环境变量模板：复制为同目录下的 .env 并填入真实值
#   cp backend/.env.example backend/.env
# .env 已被仓库根目录的 .gitignore（/backend/.env）忽略，不会提交到 Git
# 四个变量名与实际代码读取位置一一对应：
#   DATABASE_URL  -> app/db/session.py
#   SECRET_KEY    -> app/core/security.py（JWT HS256 签名密钥）
#   REDIS_URL     -> app/core/redis.py
#   ZHIPU_API_KEY -> app/services/AI.py、app/tools/web_search.py

DATABASE_URL=mysql+pymysql://<用户名>:<密码>@<主机>:3306/olist?charset=utf8mb4
SECRET_KEY=<随机字符串，建议不少于 32 字节>
REDIS_URL=redis://localhost:6379/0
ZHIPU_API_KEY=<智谱开放平台 API Key>